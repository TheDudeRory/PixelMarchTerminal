{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelMarch",
  "version": "0.1.37",
  "identifier": "io.pixelmarch.pixelmarch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PixelMarch",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      },
      {
        "label": "voice",
        "title": "Voice-To-Text",
        "url": "index.html?voice=1",
        "width": 152,
        "height": 72,
        "minWidth": 152,
        "minHeight": 72,
        "maxWidth": 320,
        "maxHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
